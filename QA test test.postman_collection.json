		{
			"name": "Import Multiple Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Each product has a title\", function () {\r",
							"    let data = pm.response.json();\r",
							"\r",
							"    const checkTitle = (item) => {\r",
							"        if (typeof item === \"object\" && item !== null) {\r",
							"            pm.expect(item).to.have.property(\"title\");\r",
							"        } else {\r",
							"            console.warn(\"Skipping item, not an object:\", item);\r",
							"        }\r",
							"    };\r",
							"\r",
							"    if (Array.isArray(data)) {\r",
							"        data.forEach(checkTitle);\r",
							"    } else if (typeof data === \"object\") {\r",
							"        Object.values(data).forEach(checkTitle);\r",
							"    }\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Each product has a valid price\", function () {\r",
							"    let data = pm.response.json();\r",
							"\r",
							"    const checkPrice = (item) => {\r",
							"        if (typeof item === \"object\" && item !== null) {\r",
							"            pm.expect(item).to.have.property(\"price\");\r",
							"            pm.expect(item.price).to.be.above(0);\r",
							"        }\r",
							"    };\r",
							"\r",
							"    if (Array.isArray(data)) {\r",
							"        data.forEach(checkPrice);\r",
							"    } else if (typeof data === \"object\") {\r",
							"        Object.values(data).forEach(checkPrice);\r",
							"    }\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Each product has a category string\", function () {\r",
							"    let data = pm.response.json();\r",
							"\r",
							"    const checkCategory = (item) => {\r",
							"        if (typeof item === \"object\" && item !== null) {\r",
							"            pm.expect(item).to.have.property(\"category\");\r",
							"            pm.expect(item.category).to.be.a(\"string\");\r",
							"        }\r",
							"    };\r",
							"\r",
							"    if (Array.isArray(data)) {\r",
							"        data.forEach(checkCategory);\r",
							"    } else if (typeof data === \"object\") {\r",
							"        Object.values(data).forEach(checkCategory);\r",
							"    }\r",
							"});\r",
							""
						],
